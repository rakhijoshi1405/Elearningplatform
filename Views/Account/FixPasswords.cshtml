@inherits System.Web.Mvc.WebViewPage<dynamic>

@{
    ViewBag.Title = "Fix Passwords";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Password Fix Utility</h2>

@if (ViewBag.Success == true)
{
    <div class="alert alert-success">
        <strong>Success!</strong> @ViewBag.Message
    </div>
}
else
{
    <div class="alert alert-danger">
        <strong>Error!</strong> @ViewBag.Message
    </div>
}

<div class="alert alert-info">
    <h4>Now you can login with:</h4>
    <p><strong>Username:</strong> Any existing username</p>
    <p><strong>Password:</strong> 123456</p>
</div>

<div>
    <a href="/Account/Login" class="btn btn-primary">Go to Login</a>
    <a href="/Account/CreateTestUser" class="btn btn-success">Create Test User</a>
</div>