<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Elearning Platform</title>

    <link href="~/Content/bootstrap.css" rel="stylesheet" />

    <style>
        body {
            padding-top: 60px;
        }

        .navbar {
            margin-bottom: 20px;
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <div class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">

            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>

                <a href="/Home/Index" class="navbar-brand">AnantVidya</a>
            </div>

            <div class="navbar-collapse collapse">

                <!-- LEFT MENU -->
                <ul class="nav navbar-nav">
                    <!-- GO TO HOME BUTTON - Appears on every screen -->
                    <li><a href="/Home/Index">🏠 Go to Home</a></li>

                    @if (User.Identity.IsAuthenticated)
                    {
                        var role = Session["Role"] as string;

                        if (role == "Admin")
                        {
                            <li><a href="/Admin/Index">Dashboard</a></li>
                            <li><a href="/Admin/PendingTeachers">Pending Teachers</a></li>
                            <li><a href="/Admin/AllTeachers">All Teachers</a></li>
                        }
                        else if (role == "Teacher")
                        {
                            <li><a href="/Teacher/MyCourses">My Courses</a></li>
                        }
                        else if (role == "Student")
                        {
                            <li><a href="/Student/AvailableCourses">Available Courses</a></li>
                            <li><a href="/Student/MyCourses">My Courses</a></li>
                        }
                    }
                </ul>

                <!-- RIGHT MENU -->
                <ul class="nav navbar-nav navbar-right">

                    @if (User.Identity.IsAuthenticated)
                    {
                        <li><span class="navbar-text">Welcome, @Session["Username"]</span></li>
                        <li>
                            <form method="post" action="/Account/Logout" style="display:inline;">
                                <button type="submit" class="btn btn-link navbar-btn" style="color:white;">
                                    🔓 Logout
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a href="/Account/Register">📝 Register</a>
                        </li>
                        <li>
                            <a href="/Account/Login">🔐 Login</a>
                        </li>
                    }

                </ul>

            </div>
        </div>
    </div>

    <!-- BODY CONTENT -->
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - AnantVidya E-learning Platform</p>
        </footer>
    </div>

    <!-- SCRIPTS -->
    <script src="~/Scripts/jquery-3.6.0.js"></script>
    <script src="~/Scripts/bootstrap.js"></script>

    @RenderSection("scripts", required: false)

</body>
</html>