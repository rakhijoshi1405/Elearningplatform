@inherits System.Web.Mvc.WebViewPage<dynamic>

@{
    ViewBag.Title = "Course Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewBag.CourseTitle</h2>
<p>@ViewBag.CourseDescription</p>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">Quizzes for this Course</h3>
        <div class="pull-right">
            <a href="/Teacher/CreateQuiz?courseId=@ViewBag.CourseId" class="btn btn-success btn-sm">+ Create New Quiz</a>
        </div>
    </div>
    <div class="panel-body">
        @if (ViewBag.Quizzes != null && ((System.Collections.IList)ViewBag.Quizzes).Count > 0)
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Quiz Title</th>
                        <th>Total Questions</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int counter = 0;
                    }
                    @foreach (var quiz in ViewBag.Quizzes)
                    {
                        <tr>
                            <td>@(counter + 1)</td>
                            <td>@quiz.Title</td>
                            <td>
                                @{
                                    int qCount = 0;
                                    if (ViewBag.QuestionCounts != null && counter < ((System.Collections.IList)ViewBag.QuestionCounts).Count)
                                    {
                                        qCount = (int)((System.Collections.IList)ViewBag.QuestionCounts)[counter];
                                    }
                                }
                                @qCount
                                </td>
                            <td>
                                <a href="/Teacher/ViewQuestions?courseId=@ViewBag.CourseId&quizId=@quiz.QuizId" class="btn btn-info btn-sm">View Questions</a>
                                <a href="/Teacher/AddQuestions?quizId=@quiz.QuizId" class="btn btn-warning btn-sm">Add Questions</a>
                                <a href="/Teacher/DeleteQuiz?quizId=@quiz.QuizId" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this quiz?')">Delete Quiz</a>
                            </td>
                        </tr>
                        counter++;
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">
                No quizzes created yet for this course.
                <a href="/Teacher/CreateQuiz?courseId=@ViewBag.CourseId">Create your first quiz!</a>
            </div>
        }
    </div>
</div>

<div>
    <a href="/Teacher/MyCourses" class="btn btn-default">Back to My Courses</a>
</div>