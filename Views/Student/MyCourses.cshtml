@inherits System.Web.Mvc.WebViewPage<dynamic>

@{
    ViewBag.Title = "My Courses";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .courses-container {
        max-width: 1200px;
        margin: 30px auto;
        padding: 20px;
    }

    .page-header {
        text-align: center;
        margin-bottom: 30px;
    }

        .page-header h2 {
            font-size: 28px;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .page-header p {
            color: #7f8c8d;
            font-size: 14px;
        }

    .courses-table {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        margin-bottom: 25px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        background: #f8f9fa;
        padding: 15px;
        text-align: left;
        font-weight: 600;
        color: #2c3e50;
        border-bottom: 2px solid #e0e0e0;
    }

    td {
        padding: 15px;
        border-bottom: 1px solid #eee;
        vertical-align: top;
    }

    tr:hover {
        background: #f8f9fa;
    }

    .course-title {
        font-weight: 600;
        color: #333;
    }

    .course-desc {
        color: #666;
        font-size: 13px;
        line-height: 1.4;
        max-width: 350px;
    }

    .enrolled-date {
        color: #666;
        font-size: 13px;
        white-space: nowrap;
    }

    .action-buttons {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .btn-video {
        background: #3498db;
        color: white;
        padding: 6px 12px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 500;
        text-align: center;
        transition: all 0.3s ease;
        display: inline-block;
    }

        .btn-video:hover {
            background: #2980b9;
            text-decoration: none;
            color: white;
        }

    .btn-quiz {
        background: #28a745;
        color: white;
        padding: 6px 12px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 500;
        text-align: center;
        transition: all 0.3s ease;
        display: inline-block;
    }

        .btn-quiz:hover {
            background: #218838;
            text-decoration: none;
            color: white;
        }

    .btn-certificate {
        background: #ffc107;
        color: #333;
        padding: 6px 12px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 500;
        text-align: center;
        transition: all 0.3s ease;
        display: inline-block;
    }

        .btn-certificate:hover {
            background: #e0a800;
            text-decoration: none;
            color: #333;
        }

    .empty-state {
        text-align: center;
        padding: 50px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

        .empty-state p {
            color: #666;
            margin-bottom: 20px;
        }

    .btn-browse {
        background: #667eea;
        color: white;
        padding: 12px 25px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        display: inline-block;
    }

        .btn-browse:hover {
            background: #5a67d8;
            text-decoration: none;
            color: white;
        }

    .btn-back {
        background: #6c757d;
        color: white;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        display: inline-block;
        margin-top: 20px;
    }

        .btn-back:hover {
            background: #5a6268;
            text-decoration: none;
            color: white;
        }

    .text-center {
        text-align: center;
    }

    .error-message {
        background: #f8d7da;
        color: #721c24;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
        border-left: 4px solid #dc3545;
    }
</style>

<div class="courses-container">
    <div class="page-header">
        <h2>My Enrolled Courses</h2>
        <p>Continue your learning journey</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="error-message">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.Enrollments != null && ((System.Collections.IList)ViewBag.Enrollments).Count > 0)
    {
        <div class="courses-table">
            <table class="table">
                <thead>
                    <tr>
                        <th>Course Title</th>
                        <th>Description</th>
                        <th>Enrolled On</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enrollment in ViewBag.Enrollments)
                    {
                        <tr>
                            <td class="course-title">@enrollment.Course.Title</td>
                            <td class="course-desc">@enrollment.Course.Description</td>
                            <td class="enrolled-date">@enrollment.EnrollmentDate.ToString("MM/dd/yyyy")</td>
                            <td class="action-buttons">
                                <a href="/Student/CourseVideos?courseId=@enrollment.CourseId" class="btn-video">▶ View Videos</a>
                                <a href="/Student/AvailableQuizzes?courseId=@enrollment.CourseId" class="btn-quiz">📝 Take Quiz</a>
                                <a href="/Student/GenerateCertificate?courseId=@enrollment.CourseId" class="btn-certificate">🎓 Get Certificate</a>
                                </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>📚 You are not enrolled in any courses yet.</p>
            <a href="/Student/AvailableCourses" class="btn-browse">Browse Available Courses</a>
        </div>
    }

    <div class="text-center">
        <a href="/Student/Index" class="btn-back">← Back to Dashboard</a>
    </div>
</div>