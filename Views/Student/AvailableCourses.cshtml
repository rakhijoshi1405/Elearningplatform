@inherits System.Web.Mvc.WebViewPage<dynamic>

@{
    ViewBag.Title = "Available Courses";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .courses-container {
        max-width: 1200px;
        margin: 30px auto;
        padding: 20px;
    }

    .page-header {
        text-align: center;
        margin-bottom: 35px;
    }

        .page-header h2 {
            font-size: 32px;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 8px;
        }

    .courses-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 25px;
        margin-bottom: 30px;
    }

    .course-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
    }

        .course-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.12);
        }

    .card-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 20px;
        color: white;
    }

        .card-header h3 {
            margin: 0;
            font-size: 20px;
            font-weight: 600;
        }

    .card-body {
        padding: 20px;
    }

    .course-description {
        color: #555;
        font-size: 14px;
        line-height: 1.5;
        margin-bottom: 15px;
        height: 80px;
        overflow: hidden;
    }

    .price-section {
        margin-bottom: 20px;
        padding-top: 10px;
        border-top: 1px solid #eee;
    }

    .price-value {
        font-size: 24px;
        font-weight: 700;
        color: #28a745;
    }

    .btn-details {
        display: block;
        text-align: center;
        background: #667eea;
        color: white;
        padding: 10px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-details:hover {
            background: #5a67d8;
            text-decoration: none;
            color: white;
        }
</style>

<div class="courses-container">
    <div class="page-header">
        <h2>Available Courses</h2>
        <p>Explore our courses and start learning today</p>
    </div>

    @if (ViewBag.Courses != null && ((System.Collections.IList)ViewBag.Courses).Count > 0)
    {
        <div class="courses-grid">
            @foreach (var course in ViewBag.Courses)
            {
                <div class="course-card">
                    <div class="card-header">
                        <h3>@course.Title</h3>
                    </div>
                    <div class="card-body">
                        <div class="course-description">
                            @course.Description
                        </div>
                        <div class="price-section">
                            <span class="price-value">₹@course.Price</span>
                        </div>
                        <a href="/Student/CourseDetails?courseId=@course.CourseId" class="btn-details">View Details →</a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <p>No courses available at this time.</p>
        </div>
    }
</div>